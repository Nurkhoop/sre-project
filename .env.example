# Standard runtime configuration for local and VM deployments.
# Copy to .env if you want to override the defaults used by docker-compose.yml.

DB_HOST=app-db
DB_PORT=5432
DB_NAME=app_db_dev
DB_USER=postgres
DB_PASSWORD=postgres

DATABASE_URL=postgresql://postgres:postgres@app-db:5432/app_db_dev

USER_SERVICE_URL=http://user-service:8000
PRODUCT_SERVICE_URL=http://product-service:8000

FRONTEND_URL=http://localhost:8080
AUTH_URL=http://localhost:8001
USER_URL=http://localhost:8002
PRODUCT_URL=http://localhost:8003
ORDER_URL=http://localhost:8004
CHAT_URL=http://localhost:8005
